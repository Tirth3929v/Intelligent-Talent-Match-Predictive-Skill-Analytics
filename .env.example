TAVILY_API_KEY=your-tavily-api-key
# Streamlit frontend API URL; defaults to http://127.0.0.1:8000
SKILLSYNC_API_BASE_URL=http://127.0.0.1:8000
# Provider API key; set OPENAI_BASE_URL and NEBIUS_MODEL to select the provider.
NEBIUS_API_KEY=your-nebius-api-key
# Optional; defaults to Nebius Token Factory.
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional; set a model available at the configured OpenAI-compatible endpoint.
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
