# ==============================================================================
# SkillSync AI - Environment Configuration
# Nebius x NVIDIA Global AI Hackathon (Best Apps & Agents Track)
# ==============================================================================

# 1. Tavily Search API (Real-Time 2026 Labor Market Grounding)
TAVILY_API_KEY=your-tavily-api-key

# 2. Nebius Token Factory & Studio Credentials
# Generate at: https://studio.nebius.ai/ -> API Keys
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
OPENAI_BASE_URL=https://api.studio.nebius.ai/v1/

# 3. Multi-Tiered NVIDIA Nemotron 3 Models (Token Factory Router)
# Fast Tier: Resume parsing, keyword canonicalization, Tavily query generation
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3-Nano-30B

# Balanced Tier: AI Role Discovery, live job market demand summarization
NEMOTRON_SUPER_MODEL=nvidia/Nemotron-3-Super-120B

# Reasoning Tier: Deep 90-day learning roadmap, architecture project recommendations
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550B

# Default / Fallback Model Identifier
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550B

# 4. Service Architecture & Security
# Streamlit connects to this FastAPI backend endpoint
SKILLSYNC_API_BASE_URL=http://127.0.0.1:8000

# Zero-trust internal service communication token (X-API-Key)
SKILLSYNC_INTERNAL_API_KEY=skillsync-internal-secure-token-2026
